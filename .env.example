# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-min-50-characters-change-this
DJANGO_DEBUG=True

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=retano_db
DB_USER=retano_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Options: require | disable | verify-full
# Use 'disable' for local dev, 'require' or 'verify-full' for production
DB_SSLMODE=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=120

# ── Kavenegar (Iranian SMS provider) ─────────────────────────────────────────
KAVENEGAR_API_KEY=your-kavenegar-api-key

# ── CORS (production only — comma-separated) ──────────────────────────────────
# Example: https://app.retano360.com,https://panel.retano360.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Email (production only) ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@retano360.com
